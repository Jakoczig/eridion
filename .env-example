# Legacy Node service and Windows packaging example.
# Native ERIDION uses launcher settings or --journal-dir / --data-dir instead.
# Leave LOG_DIR unset for automatic journal discovery.
# For Windows paths, use the --save-game-dir CLI option described in BUILD.md.
# Optional POSIX absolute override; relative values are based at src/service/.
# LOG_DIR=/absolute/path/to/journals

# Signing is optional and off by default. Publishing is a separate maintainer action.
# To enable it, supply a certificate you control and configure the signing tools.
SIGN_BUILD=false
SIGN_CERT_NAME="YOUR_CERTIFICATE_SUBJECT"
SIGN_TIME_SERVER="http://time.certum.pl"
